# ==========================================
# EMSTRAP Backend Production Environment Variables
# ==========================================

# Server Port (Render / Railway / Heroku will inject PORT automatically)
PORT=5000

# Environment mode ('production' or 'development')
NODE_ENV=production

# Frontend URLs for CORS (comma-separated or single)
FRONTEND_URL=https://emstrapteams.netlify.app
ALLOWED_ORIGINS=https://emstrapteams.netlify.app,https://emstrap.com,https://emstrap-finalworking.netlify.app

# Database Connections (MongoDB Atlas or standalone MongoDB)
# Note: If your cluster holds all collections in one database, MONGO_URI_BOOKING can be the same as MONGO_URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/EMSTRAP-Emergency?retryWrites=true&w=majority
MONGO_URI_BOOKING=mongodb+srv://<username>:<password>@cluster0.mongodb.net/EMSTRAP-Booking?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random secret in production)
JWT_SECRET=your-super-secure-production-jwt-secret-key-32chars

# AI Incident Classification (true / false)
ENABLE_AI=true

# Cloudinary Storage for Incident Evidence Uploads
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Initial System Administrator Credentials
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_PASSWORD=change_this_admin_password
DEFAULT_ADMIN_MOBILE=9876543210
DEFAULT_ADMIN_ADDRESS=Admin HQ
DEFAULT_ADMIN_CITY=Bangalore

# Email Notification Service (SMTP)
EMAIL_USER=emstrapteams@gmail.com
EMAIL_PASS=your-gmail-app-password
