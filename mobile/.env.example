# ==========================================
# EMSTRAP Mobile (React Native / Expo) Environment Variables
# ==========================================

# Hosted Production Backend URL (e.g., https://your-backend.onrender.com)
# When developing locally on Wi-Fi, you can set it to your computer's local IP (e.g. http://192.168.1.100:5000)
EXPO_PUBLIC_API_URL=https://your-hosted-backend-url.com

# Optional: Google Maps Android API Key
# If left empty, EMSTRAP automatically falls back to OpenStreetMap raster tiles for 100% free offline/online map rendering.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
